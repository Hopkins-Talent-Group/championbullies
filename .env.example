# Contact + reservation delivery. Set at least one channel, or the forms will
# tell the visitor their message could not be sent and offer the
# phone/email fallback. Nothing here is exposed to the browser.

# Inbound webhook: GoHighLevel, Zapier, Make, or any endpoint you control.
RESERVATION_WEBHOOK_URL=

# Resend email delivery (https://resend.com)
RESEND_API_KEY=
RESERVATION_NOTIFY_EMAIL=championbullies@aol.com
RESERVATION_FROM_EMAIL=